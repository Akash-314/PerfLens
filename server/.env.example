# PerfLens Backend Server Environment Template
# Copy this file to server/.env and fill with your actual configuration.

PORT=5001
NODE_ENV=production

# Security & CORS (comma-separated origins or * for open)
CORS_ORIGIN=*
JWT_SECRET=your_secure_random_jwt_secret_key_minimum_32_characters

# Public API Gateway URL
API_URL=/api/v1

# Supabase PostgreSQL Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Google PageSpeed Insights API Key (optional)
PAGESPEED_API_KEY=your_google_pagespeed_api_key_here

# Concurrency Limit for Heavy Puppeteer Scans
MAX_CONCURRENT_SCANS=3
