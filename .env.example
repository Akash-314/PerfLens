# PerfLens Environment Configuration Template
# Copy this file to .env (or server/.env) and fill in the values for your deployment.

# ==============================================================================
# Server Configuration
# ==============================================================================
PORT=5001
NODE_ENV=production

# Security & CORS (comma-separated allowed origins or * for open CORS)
CORS_ORIGIN=*
JWT_SECRET=your_secure_random_jwt_secret_key_minimum_32_characters

# Public API Gateway URL (used for OpenAPI docs and reverse proxies)
API_URL=/api/v1

# ==============================================================================
# Database & Persistence (Supabase PostgreSQL)
# ==============================================================================
# Retrieve from Supabase Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# ==============================================================================
# External Telemetry (Optional)
# ==============================================================================
# Google PageSpeed Insights API Key (optional, defaults to local Puppeteer lab audit if omitted)
PAGESPEED_API_KEY=your_google_pagespeed_api_key_here

# ==============================================================================
# Concurrency & Resource Governance
# ==============================================================================
# Maximum simultaneous Puppeteer Chrome instances to run before queueing
MAX_CONCURRENT_SCANS=3

# ==============================================================================
# Client Frontend Build Configuration
# ==============================================================================
# Base URL for API calls made from the React SPA (defaults to /api/v1 for reverse proxies)
VITE_API_BASE_URL=/api/v1
